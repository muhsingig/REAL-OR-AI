# Copy this file to .env and add ONE key to get AI-written fakes.
# Without a key the demo still plays with hand-written fakes, and your own
# chats get fakes remixed offline from each person's messages.

# --- Gemini (free plan, no credit card) ---
# Key from https://aistudio.google.com/apikey. On the free plan Google may keep
# and review what you send; players are told this before they agree.
# If your key is on a paid (billing) plan, set GEMINI_PAID=1 to drop that notice.
GEMINI_API_KEY=
# Models are tried in order; one that stalls or fails moves to the back.
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest
# GEMINI_PAID=1

# --- Mistral ---
# Key from https://console.mistral.ai. Turn off training on your data:
# Admin panel > Privacy > switch off "Anonymous improvement data".
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# --- Claude (paid, writes the most convincing fakes) ---
ANTHROPIC_API_KEY=
# REAL_OR_AI_MODEL=claude-opus-5-5

# If more than one key is set: gemini, then mistral, then claude, unless you choose here.
# LLM_PROVIDER=

# When the game is online, set a password so only you can host games on your AI key.
# Phones never need it. Leave empty for local play.
# HOST_PASSWORD=

# Optional: port for `npm start` (the dev server always runs on 5173).
# PORT=3000
